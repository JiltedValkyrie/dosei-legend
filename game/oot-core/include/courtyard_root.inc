static void Courtyard_ZeldaMove(Actor* actor, SkelAnime* skel) {
    const CourtyardRootPoint* points = NULL;
    unsigned count = 0;
    if (skel->animation == &gChildZeldaAnim_01B874) { points=gChildZeldaAnim_01B874_root; count=25; }
    if (skel->animation == &gChildZeldaAnim_01BCF0) { points=gChildZeldaAnim_01BCF0_root; count=1; }
    if (skel->animation == &gChildZeldaAnim_0125E4) { points=gChildZeldaAnim_0125E4_root; count=27; }
    if (skel->animation == &gChildZeldaAnim_012E58) { points=gChildZeldaAnim_012E58_root; count=1; }
    if (skel->animation == &gChildZeldaAnim_015F14) { points=gChildZeldaAnim_015F14_root; count=51; }
    if (skel->animation == &gChildZeldaAnim_0169B4) { points=gChildZeldaAnim_0169B4_root; count=28; }
    if (skel->animation == &gChildZeldaAnim_016D08) { points=gChildZeldaAnim_016D08_root; count=1; }
    if (skel->animation == &gChildZeldaAnim_01805C) { points=gChildZeldaAnim_01805C_root; count=1; }
    if (skel->animation == &gChildZeldaAnim_01A2FC) { points=gChildZeldaAnim_01A2FC_root; count=8; }
    if (skel->animation == &gChildZeldaAnim_01AAE0) { points=gChildZeldaAnim_01AAE0_root; count=1; }
    if (skel->animation == &gChildZeldaAnim_01CE08) { points=gChildZeldaAnim_01CE08_root; count=1; }
    if (skel->animation == &gChildZeldaAnim_018898) { points=gChildZeldaAnim_018898_root; count=8; }
    if (skel->animation == &gChildZeldaAnim_01910C) { points=gChildZeldaAnim_01910C_root; count=1; }
    if (skel->animation == &gChildZeldaAnim_00F0A4) { points=gChildZeldaAnim_00F0A4_root; count=12; }
    if (skel->animation == &gChildZeldaAnim_00F894) { points=gChildZeldaAnim_00F894_root; count=1; }
    if (!points) return;
    int frame = (int)skel->curFrame; unsigned i=0;
    while (i+1<count && points[i+1].frame<=frame) ++i;
    f32 x=points[i].x, z=points[i].z;
    f32 sine=Math_SinS(actor->shape.rot.y), cosine=Math_CosS(actor->shape.rot.y);
    f32 oldSine=Math_SinS(skel->prevRot), oldCosine=Math_CosS(skel->prevRot);
    if (!(skel->movementFlags & ANIM_FLAG_ADJUST_STARTING_POS)) {
        actor->world.pos.x += (x*cosine+z*sine-skel->prevTransl.x*oldCosine-skel->prevTransl.z*oldSine)*actor->scale.x;
        actor->world.pos.z += (z*cosine-x*sine-skel->prevTransl.z*oldCosine+skel->prevTransl.x*oldSine)*actor->scale.z;
    }
    skel->prevTransl.x=points[i].x; skel->prevTransl.z=points[i].z;
    skel->prevRot=actor->shape.rot.y;
    skel->movementFlags &= ~ANIM_FLAG_ADJUST_STARTING_POS;
}
